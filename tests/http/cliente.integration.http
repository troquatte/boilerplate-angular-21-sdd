@host = http://localhost:4000

### Listar clientes (paginado default)
# Expected: 200 OK, meta: { page: 1, pageSize: 10, total, totalPages }
GET {{host}}/api/dashboard/clientes

### Listar clientes página 2
# Expected: 200 OK, retorna itens da página 2
GET {{host}}/api/dashboard/clientes?page=2&pageSize=10

### Buscar clientes por telefone
# Expected: 200 OK, retorna apenas clientes que contenham "119" no phone
GET {{host}}/api/dashboard/clientes?page=1&pageSize=10&search=119

### Buscar clientes por CPF
# Expected: 200 OK, retorna apenas clientes que contenham "123" no cpf
GET {{host}}/api/dashboard/clientes?page=1&pageSize=10&search=123

### Criar cliente sem email (sem login)
# Expected: 201 Created
POST {{host}}/api/dashboard/clientes
Content-Type: application/json

{
  "phone": "11987654321",
  "cpf": "12345678901",
  "fullName": "Ana Carolina Silva",
  "tipo": "PF"
}

### Criar cliente com email (gera User)
# Expected: 201 Created
POST {{host}}/api/dashboard/clientes
Content-Type: application/json

{
  "phone": "21976543210",
  "cpf": "23456789012",
  "fullName": "Bruno Oliveira",
  "email": "bruno@example.com",
  "tipo": "PF"
}

### Criar cliente com email sem CPF (erro)
# Expected: 400 Bad Request
POST {{host}}/api/dashboard/clientes
Content-Type: application/json

{
  "phone": "31965432109",
  "fullName": "Carla Souza",
  "email": "carla@example.com"
}

### Atualizar cliente
# Expected: 200 OK
PATCH {{host}}/api/dashboard/clientes/UUID_AQUI
Content-Type: application/json

{
  "phone": "11999999999"
}

### Deletar cliente
# Expected: 204 No Content
DELETE {{host}}/api/dashboard/clientes/UUID_AQUI
