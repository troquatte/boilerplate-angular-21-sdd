@host = http://localhost:4200
@adminToken = ADMIN_JWT_TOKEN_HERE
@clientToken = CLIENT_JWT_TOKEN_HERE

### 1. Criar cliente com sucesso (ADMIN)
# Expected: 201 Created
POST {{host}}/api/customers
Cookie: accessToken={{adminToken}}
Content-Type: application/json

{
  "phone": "11988887777",
  "name": "Dener",
  "cpf": "123.456.789-00",
  "userId": "USER_ID_DE_TESTE_AQUI"
}

### 2. Criar cliente apenas com telefone (ADMIN)
# Expected: 201 Created
POST {{host}}/api/customers
Cookie: accessToken={{adminToken}}
Content-Type: application/json

{
  "phone": "11988887777",
  "userId": "USER_ID_DE_TESTE_B_AQUI"
}

### 3. Criar cliente (Não-ADMIN / CLIENT)
# Expected: 403 Forbidden
POST {{host}}/api/customers
Cookie: accessToken={{clientToken}}
Content-Type: application/json

{
  "phone": "11999999999",
  "userId": "USER_ID_DE_TESTE_AQUI"
}

### 4. Listar todos os clientes (ADMIN)
# Expected: 200 OK
GET {{host}}/api/customers?page=1&limit=10
Cookie: accessToken={{adminToken}}

### 5. Listar todos os clientes (Não-ADMIN / CLIENT)
# Expected: 403 Forbidden
GET {{host}}/api/customers?page=1&limit=10
Cookie: accessToken={{clientToken}}

### 6. Obter um cliente por ID (ADMIN)
# Expected: 200 OK
GET {{host}}/api/customers/CUSTOMER_ID_AQUI
Cookie: accessToken={{adminToken}}

### 7. Obter seu próprio perfil de cliente (Não-ADMIN / CLIENT)
# Expected: 200 OK
GET {{host}}/api/customers/CUSTOMER_DO_PROPRIO_USER_ID
Cookie: accessToken={{clientToken}}

### 8. Obter perfil de cliente de terceiros (Não-ADMIN / CLIENT)
# Expected: 403 Forbidden
GET {{host}}/api/customers/CUSTOMER_DE_TERCEIRO_ID
Cookie: accessToken={{clientToken}}

### 9. Editar cliente (ADMIN ou Proprietário)
# Expected: 200 OK
PUT {{host}}/api/customers/CUSTOMER_ID_AQUI
Cookie: accessToken={{adminToken}}
Content-Type: application/json

{
  "name": "Dener Editado",
  "phone": "11977776666"
}

### 10. Desativar cliente (ADMIN)
# Expected: 200 OK
DELETE {{host}}/api/customers/CUSTOMER_ID_AQUI
Cookie: accessToken={{adminToken}}

### 11. Desativar cliente (Não-ADMIN / CLIENT)
# Expected: 403 Forbidden
DELETE {{host}}/api/customers/CUSTOMER_ID_AQUI
Cookie: accessToken={{clientToken}}
